# Облачный ключ. Обычный локальный llama.cpp работает без ключа;
# приватный сервис использует отдельные TABLETOP_*_API_KEY.
OPENCODE_API_KEY=sk-ваш_ключ
# TABLETOP_LLAMA_AUTOSTART=0 — не запускать и не останавливать llama-server
# TABLETOP_LLAMA_START_TIMEOUT=120 — секунды ожидания запуска
# TABLETOP_LOCAL_API_URL=http://127.0.0.1:9999/v1/chat/completions
# TABLETOP_LOCAL_API_KEY — отдельный ключ приватного сервиса, опционален для обычного локального режима
# TABLETOP_SERVICE_API_KEY — обязательный ключ для tabletop-llm-service.py
